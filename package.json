{
  "name": "athanor",
  "version": "0.3.0",
  "description": "Code-driven pixel art effects and animations, and a Claude Code skill to make your own.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./authoring": "./src/authoring/index.js",
    "./fx/*": "./src/fx/*.js",
    "./core/*": "./src/core/*.js"
  },
  "scripts": {
    "render": "node tools/render.mjs",
    "check": "node tools/check.mjs",
    "gallery": "node tools/serve.mjs",
    "lab": "node experiments/vfx-lab/server.mjs",
    "lab:tools": "node experiments/vfx-lab/cli.mjs tools",
    "lab:mcp": "node experiments/vfx-lab/mcp.mjs",
    "lab:test": "node --test --test-concurrency=1 experiments/vfx-lab/test.mjs experiments/vfx-lab/authoring.test.mjs experiments/vfx-lab/particle.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
